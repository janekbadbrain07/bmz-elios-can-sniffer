# =============================================================
# SZABLON PLIKU secrets.yaml
#
# 1. Skopiuj ten plik jako "secrets.yaml" (bez końcówki .example)
#    w tym samym katalogu co bmz_elios_can.yaml.
# 2. Zamień wszystkie wartości poniżej na własne.
# 3. NIE wrzucaj prawdziwego secrets.yaml na GitHub
#    (jest wykluczony w pliku .gitignore).
# =============================================================

# Dane Twojej sieci Wi-Fi
wifi_ssid: "Twoja_Nazwa_WiFi"
wifi_password: "Twoje_Haslo_WiFi"

# Klucz szyfrowania API (Home Assistant <-> ESPHome).
# Musi to być 32 bajty zakodowane w base64. Wygenerujesz go np.:
#   openssl rand -base64 32
# albo skopiujesz z kreatora nowego urządzenia w ESPHome Dashboard.
api_encryption_key: "WKLEJ_TUTAJ_WYGENEROWANY_KLUCZ_BASE64"

# Hasło do aktualizacji OTA (przez Wi-Fi)
ota_password: "Twoje_Haslo_OTA"

# Hasło awaryjnego hotspotu Wi-Fi (min. 8 znaków).
# Urządzenie uruchomi go, gdy nie połączy się z Twoją siecią.
fallback_ap_password: "Twoje_Haslo_Hotspotu"
